# ProcessIQ — servidor web (Caddy)
#
# El dominio y el modo del certificado vienen de .env (DOMINIO, TLS_MODO):
# para cambiar de dominio no se toca este archivo. Ver docs/runbooks/servidor-local.md
#
# El puerto 80 del servidor lo ocupa IIS: no hay redireccion HTTP -> HTTPS y el
# certificado de Let's Encrypt se obtiene con el desafio TLS-ALPN (solo 443).
{
	auto_https disable_redirects
	# HTTP/3 necesitaria abrir tambien UDP 443 en el router: se deja en h1/h2.
	servers {
		protocols h1 h2
		# Solo staging (detrás del Caddy de producción) confía en su X-Forwarded-For:
		# PROXIES_CONFIABLES=private_ranges. En producción, nadie (solo localhost).
		trusted_proxies static {$PROXIES_CONFIABLES:127.0.0.1/32}
	}
}

# TLS_MODO=acme    certificado real de Let's Encrypt (produccion)
# TLS_MODO=interno certificado de la CA interna de Caddy (pruebas en localhost)
(tls-acme) {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
}

(tls-interno) {
	tls internal
}

# TLS_MODO=ninguno  HTTP simple: staging, detrás del Caddy de producción (SITIO_WEB=:80)
(tls-ninguno) {
}

# Cabeceras de todo el sitio. La E2E (pruebas/e2e/src/csp.mjs) las lee de aquí y
# sirve la web con las mismas: una directiva nueva se prueba con `pnpm e2e`.
# Qué necesita cada directiva de la CSP: docs/tecnica/seguridad.md §9.
(cabeceras-seguridad) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://api.anthropic.com; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Permissions-Policy "camera=(), geolocation=(), microphone=(self)"
		-Server
	}
}

{$DOMINIO} {
	import tls-{$TLS_MODO:acme}
	import cabeceras-seguridad
	encode zstd gzip

	# Intermediario de IA (mismo origen que la web). flush_interval -1 reenvia
	# el streaming SSE de Claude sin acumularlo.
	handle_path /ia/* {
		reverse_proxy intermediario:8787 {
			flush_interval -1
		}
	}

	# API (cuentas, proyectos, revisiones). Caddy pone X-Forwarded-For con la IP
	# real del cliente (no confía en la que envía el navegador).
	handle /api/* {
		reverse_proxy api:8080
	}

	# Shell de proyectos (React): rutas del lado del cliente bajo /proyectos/.
	# Sus JS y CSS están en /assets/, así que aquí solo llegan rutas de pantalla.
	handle /proyectos* {
		root * /srv
		try_files {path} /proyectos/index.html
		header Cache-Control "no-cache"
		file_server
	}

	handle {
		root * /srv
		# index.html se sirve como plantilla para resolver {{.Host}} (Open Graph)
		@html path / /index.html
		templates @html
		header @html Cache-Control "no-cache"
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		# Montserrat (public/fonts/): nombres sin hash, así que una semana y no «immutable»
		header /fonts/* Cache-Control "public, max-age=604800"
		file_server
	}

	handle_errors 404 {
		import cabeceras-seguridad
		root * /srv
		rewrite * /404.html
		file_server
	}
}

# Sitios opcionales montados en /etc/caddy/sitios (p. ej. staging.caddy, solo en
# producción: reenvía staging.<dominio> al Caddy de staging). Sin archivos, nada.
import /etc/caddy/sitios/*.caddy

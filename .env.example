# ============================================================
# ProcessIQ — configuracion del servidor. Copiar a .env y completar.
# .env NUNCA se sube al repositorio (tiene secretos).
# Tras cambiar algo:  docker compose up -d
# ============================================================

# Dominio publico. Para cambiarlo: editar aqui, crear el registro DNS
# (tipo A -> IP publica del servidor) y ejecutar `docker compose up -d`.
# Caddy pide el certificado nuevo solo.
DOMINIO=mbc.asissoft.com

# acme    = certificado real de Let's Encrypt (requiere DNS y el puerto 443 abierto)
# interno = certificado propio de Caddy, solo para pruebas en localhost
TLS_MODO=acme

# Puerto HTTPS publicado en el PC (el router debe reenviar el 443 externo aqui)
PUERTO_HTTPS=443

# Origenes que pueden llamar al intermediario de IA. Por defecto https://$DOMINIO.
# Solo hace falta si se publica en un puerto distinto de 443, p. ej. https://localhost:8443
# ALLOWED_ORIGINS=

# Base de datos de la plataforma (Postgres en Docker). Contraseña larga y
# aleatoria; si se cambia después de crear la base, hay que cambiarla también
# dentro de Postgres (ALTER USER).
POSTGRES_PASSWORD=

# Duración de las sesiones de usuario, en horas
HORAS_SESION=12

# Copias de seguridad: una al día a esta hora local (vacía = una cada 24 h desde el arranque)
RESPALDO_HORA=03:00
ZONA_HORARIA=America/Lima
# Segundos de espera antes de la primera copia tras arrancar (la API crea antes las tablas)
# RESPALDO_ESPERA_INICIAL_S=300

# Red Docker que comparten producción y staging. Solo se cambia para pruebas
# aisladas, y entonces con el mismo valor en .env y en .env.staging.
# RED_BORDE=processiq-borde

# Intermediario de IA (modo "Clave del equipo" de la app)
# >>> PEGAR AQUI LA CLAVE DE ANTHROPIC (empieza por sk-ant-), sin comillas ni espacios.
# Crearla en console.anthropic.com DENTRO DE UN WORKSPACE y con tope de gasto mensual.
# Despues: docker compose up -d intermediario api worker
ANTHROPIC_API_KEY=
ACCESS_CODE=

# (Opcional) registro central del gasto de IA
PULSE_URL=
PULSE_TOKEN=

# IA en el servidor (fase 2.3): generaciones y análisis de los procesos de proyectos.
# La hace el servicio "worker" con la misma ANTHROPIC_API_KEY de arriba.
# Topes de gasto por mes calendario, en US$ a precio de lista de Anthropic.
PRESUPUESTO_IA_MENSUAL_USD=100
LIMITE_IA_USUARIO_MENSUAL_USD=25
# Modelos que se pueden elegir al generar, y el de los análisis (pains y copiloto)
MODELOS_IA_PERMITIDOS=claude-opus-5,claude-sonnet-5
MODELO_IA_ANALISIS=claude-sonnet-5
# Ejecuciones de IA a la vez
IA_CONCURRENCIA=2

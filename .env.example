# ============================================================
# ProcessIQ — configuracion del servidor. Copiar a .env y completar.
# .env NUNCA se sube al repositorio (tiene secretos).
# Tras cambiar algo:  docker compose up -d
# ============================================================

# Dominio publico. Para cambiarlo: editar aqui, crear el registro DNS
# (tipo A -> IP publica del servidor) y ejecutar `docker compose up -d`.
# Caddy pide el certificado nuevo solo.
DOMINIO=mbc.asissoft.com

# acme    = certificado real de Let's Encrypt (requiere DNS y el puerto 443 abierto)
# interno = certificado propio de Caddy, solo para pruebas en localhost
TLS_MODO=acme

# Puerto HTTPS publicado en el PC (el router debe reenviar el 443 externo aqui)
PUERTO_HTTPS=443

# Origenes que pueden llamar al intermediario de IA. Por defecto https://$DOMINIO.
# Solo hace falta si se publica en un puerto distinto de 443, p. ej. https://localhost:8443
# ALLOWED_ORIGINS=

# Intermediario de IA (modo "Clave del equipo" de la app)
ANTHROPIC_API_KEY=
ACCESS_CODE=

# (Opcional) registro central del gasto de IA
PULSE_URL=
PULSE_TOKEN=

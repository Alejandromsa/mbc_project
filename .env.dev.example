# Desarrollo local de la API (pnpm --filter @processiq/api dev). Copiar a .env.dev.
# Base: el Postgres de desarrollo (docker compose -f docker-compose.dev.yml up -d).
DATABASE_URL=postgres://processiq:processiq@localhost:5440/processiq
# La web de desarrollo (Vite) llama a la API por su proxy /api
ORIGEN_PUBLICO=http://localhost:5173
PORT=8790

# Intermediario de IA del editor libre (pnpm --filter @processiq/intermediario dev),
# solo si vas a probar el modo «Clave del equipo». Lee este archivo (o .env si no existe).
# Vite le reenvía /ia con el origen de la web, que tiene que estar permitido.
# Ojo: ANTHROPIC_API_KEY aquí también la ven la API y el worker de desarrollo, y gasta de verdad.
# ALLOWED_ORIGINS=http://localhost:5173
# ACCESS_CODE=
# ANTHROPIC_API_KEY=

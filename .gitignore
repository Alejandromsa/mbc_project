# Dependencias y builds
node_modules/
dist/
.turbo/
*.tsbuildinfo

# Configuración local con secretos (usar .env.example como plantilla)
.env
.env.*
!.env.example
!.env.dev.example
!.env.staging.example

# Librerías de navegador copiadas desde node_modules en cada build
apps/web/public/vendor/
# Montserrat, igual (montserrat.css sí se versiona)
apps/web/public/fonts/*
!apps/web/public/fonts/montserrat.css

# Resultados de pruebas
pruebas/*/resultados/
pruebas/*/playwright-report/
test-results/

# Banco de pruebas: los fixtures son procesos reales de cliente
bench/fixtures/

# SO / editor
Thumbs.db
.DS_Store
desktop.ini
*~
.vscode/
.idea/
.claude/

# Copias de seguridad de la base (docker compose: servicio respaldo)
respaldos/
respaldos-*/
despliegues.log

# Archivos locales que nunca se publican: notas personales de Claude Code (CLAUDE.local.md)
# y datos del servidor (servidor-datos.local.md). Ver docs/adr/0018-repositorio-publico.md
*.local.md

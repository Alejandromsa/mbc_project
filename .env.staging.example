# ============================================================
# ProcessIQ — STAGING en el mismo servidor. Copiar a .env.staging y completar.
# .env.staging NUNCA se sube al repositorio. Uso: infra/desplegar.sh staging
# Guía: docs/runbooks/despliegue.md
# ============================================================

# Dominio público de staging (registro A → la misma IP; lo sirve el Caddy de producción)
DOMINIO=staging.mbc.asissoft.com
ORIGEN_PUBLICO=https://staging.mbc.asissoft.com
ALLOWED_ORIGINS=https://staging.mbc.asissoft.com

# El Caddy de staging escucha HTTP detrás del de producción: no publica puertos ni pide certificado
SITIO_WEB=:80
TLS_MODO=ninguno
PROXIES_CONFIABLES=private_ranges
# Red compartida con producción: si se cambia, con el mismo valor que en .env
# RED_BORDE=processiq-borde

# Base de datos propia de staging (otra contraseña que producción)
POSTGRES_PASSWORD=
HORAS_SESION=12

# IA: puede ser la misma clave, con topes más bajos
ANTHROPIC_API_KEY=
ACCESS_CODE=
PRESUPUESTO_IA_MENSUAL_USD=10
LIMITE_IA_USUARIO_MENSUAL_USD=5
IA_CONCURRENCIA=1

# Copias de staging en su propia carpeta, media hora después de las de producción
CARPETA_RESPALDOS=./respaldos-staging
RESPALDO_HORA=03:30
